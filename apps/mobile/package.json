{
  "name": "@collection-war/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Collection War Android and iOS application. Technical shell only — no gameplay.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "node ../../scripts/mobile-build-note.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node ../../scripts/clean.mjs"
  },
  "dependencies": {
    "@collection-war/api-client": "workspace:*",
    "@collection-war/localization": "workspace:*",
    "@collection-war/shared-types": "workspace:*",
    "@expo/metro-runtime": "57.0.7",
    "@tanstack/react-query": "5.101.4",
    "expo": "57.0.8",
    "expo-constants": "57.0.7",
    "expo-linking": "57.0.4",
    "expo-localization": "57.0.1",
    "expo-router": "57.0.8",
    "expo-secure-store": "57.0.1",
    "expo-status-bar": "57.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.26.2"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
