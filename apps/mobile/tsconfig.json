{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    /* Expo's base config is not as strict as the repository baseline. These restore it —
       a package may add strictness, never remove it (docs/constitution/ENGINEERING_PRINCIPLES.md). */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "expo-env.d.ts", ".expo/types/**/*.ts"],
  "exclude": ["node_modules", ".expo", "dist"]
}
