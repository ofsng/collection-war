# =============================================================================
# Collection War — example environment
# =============================================================================
# Copy to `.env` and adjust:      cp .env.example .env
#
# RULES (docs/security/SECRET_MANAGEMENT.md):
#   1. `.env` is git-ignored. Never commit it.
#   2. This file contains PLACEHOLDERS ONLY. Never paste a real secret here,
#      not even a "temporary" one — this file is public in every clone.
#   3. Values below are safe ONLY because every service they point at is a
#      local, non-networked development container.
#   4. Every variable here is validated at process start by
#      @collection-war/configuration. An invalid or missing value crashes the
#      process immediately with a readable message — it never falls back silently.
# =============================================================================

# ----------------------------------------------------------------- runtime
NODE_ENV=development
# Named separately from NODE_ENV so that a production-mode build can still run
# against a development deployment without lying about which data it touches.
COLLECTION_WAR_ENV=local
LOG_LEVEL=debug

# --------------------------------------------------------------------- API
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Comma-separated. Must never be "*" outside local development.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# ---------------------------------------------------------------- database
# Matches the `postgres` service in docker-compose.yml.
DATABASE_URL=postgresql://collection_war:collection_war_local_dev@localhost:5432/collection_war
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ------------------------------------------------------------------- redis
# Cache and job queue ONLY. Redis is never the source of truth for player state.
# See docs/architecture/DATA_ARCHITECTURE.md#redis-is-not-a-database.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------- object storage
# S3-compatible. Locally this is MinIO; in a hosted environment it is any S3 API.
# The application must never import a cloud-provider-specific SDK feature.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=collection-war-local
STORAGE_ACCESS_KEY_ID=collection_war_local
STORAGE_SECRET_ACCESS_KEY=collection_war_local_dev
STORAGE_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------- mail
# Mailpit. Captures all outbound mail locally; nothing leaves the machine.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=no-reply@collection-war.local

# --------------------------------------------------------------- security
# PLACEHOLDER. Generate a real one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# A value shorter than 32 characters is rejected at startup.
AUTH_JWT_SECRET=replace-me-local-development-only-not-a-real-secret
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=2592000

# ------------------------------------------------------------ feature flags
# Real-money withdrawal stays OFF until legal and payment compliance is complete.
# See docs/constitution/ECONOMY_INTEGRITY_RULES.md.
FEATURE_MARKETPLACE_ENABLED=false
FEATURE_REAL_MONEY_WITHDRAWAL_ENABLED=false

# ---------------------------------------------------------- client (public)
# NEXT_PUBLIC_* and EXPO_PUBLIC_* are embedded in client bundles and are visible to
# anyone who opens the app. Never put a secret behind these prefixes.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=tr-TR
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_DEFAULT_LOCALE=tr-TR
