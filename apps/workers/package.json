{
  "name": "@collection-war/workers",
  "version": "0.0.0",
  "private": true,
  "description": "Background job processing. Queue foundation only — no game jobs implemented yet.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node ../../scripts/clean.mjs"
  },
  "dependencies": {
    "@collection-war/configuration": "workspace:*",
    "@collection-war/database": "workspace:*",
    "@collection-war/domain": "workspace:*",
    "@collection-war/observability": "workspace:*",
    "@collection-war/shared-types": "workspace:*",
    "bullmq": "5.81.2",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
