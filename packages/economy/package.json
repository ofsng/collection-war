{
  "name": "@collection-war/economy",
  "version": "0.0.0",
  "private": true,
  "description": "Ledger primitives and economy invariants. UI-independent and storage-independent.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node ../../scripts/clean.mjs"
  },
  "dependencies": {
    "@collection-war/domain": "workspace:*",
    "@collection-war/shared-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
