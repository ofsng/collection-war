# Fail loudly when the active Node version does not satisfy `engines`.
# The default Node on this machine is v18 (EOL); this project requires >= 20.19.
engine-strict=true

# pnpm's default isolated node_modules layout is intentional: a package can only
# import what it declares in its own package.json. This is the install-time half of
# the boundary enforcement described in docs/architecture/DEPENDENCY_RULES.md.
# The lint-time half is eslint-plugin-boundaries.
#
# Do NOT switch to node-linker=hoisted to "fix" a missing import. Add the missing
# dependency to the package that uses it instead.
node-linker=isolated

# Peer ranges across Next.js / Expo / React 19 are still settling; a hard failure
# here blocks installs for warnings we cannot act on. Peer warnings are still printed.
strict-peer-dependencies=false

# Reproducibility: exact versions, no silent drift.
save-exact=true
