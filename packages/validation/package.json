{
  "name": "@collection-war/validation",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime schema validation primitives shared by every trust boundary.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node ../../scripts/clean.mjs"
  },
  "dependencies": {
    "@collection-war/shared-types": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
